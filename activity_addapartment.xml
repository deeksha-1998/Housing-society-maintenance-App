<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    >
<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/background">



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/ADD_APARTMENT"
            android:textColor="@android:color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/name"
            style="@style/EditTextStyle"
            android:layout_width="331dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/ENTER_APARTMENT_NAME"
            android:inputType="text" />

        <LinearLayout style="@style/LinearLayoutStyle" />

        <EditText
            android:id="@+id/description"
            style="@style/EditTextStyle"
            android:layout_width="331dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif"
            android:hint="@string/ENTER_DESCRIPTION"
            android:inputType="text" />

        <LinearLayout style="@style/LinearLayoutStyle" />


        <EditText
            android:id="@+id/address"
            style="@style/EditTextStyle"
            android:layout_width="337dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif"
            android:hint="@string/ENTER_ADDRESS"
            android:inputType="textMultiLine"
            android:lines="5"
            android:gravity="start"
            />

        <LinearLayout style="@style/LinearLayoutStyle" />

        <EditText
            android:id="@+id/no_of_flats"
            style="@style/EditTextStyle"
            android:layout_width="337dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif"
            android:hint="@string/ENTER_NUMBER_OF_FLATS"
            android:inputType="numberSigned"
            />

        <LinearLayout style="@style/LinearLayoutStyle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/LOGO"
            android:layout_margin="10dp"
            android:textSize="18sp"
            android:textColor="@color/primary_text"
            android:onClick="selectPhoto"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            />
    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:visibility="gone"
        android:id="@+id/image"
        android:layout_gravity="center"
        android:layout_margin="20dp"/>
    <LinearLayout style="@style/LinearLayoutStyle" />

    <Button
            style="@style/ButtonStyle"
            android:layout_marginTop="10dp"
            android:onClick="addApartment"
            android:text="@string/ADD" />


    </LinearLayout>
</ScrollView>

