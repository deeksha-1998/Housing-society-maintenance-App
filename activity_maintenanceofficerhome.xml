<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    >
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="wrap_content"
        android:layout_height="150dp"
        android:src="@drawable/maintenanceofficer"
        android:layout_gravity="center"
         />

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/options"
        android:layout_margin="10dp"
        android:layout_marginTop="20dp">

        <RadioButton
            android:id="@+id/addresident"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/ADD_RESIDENT"
            android:textSize="20sp"
            android:checked="true"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/addvacantflat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/ADD_VACANT_FLAT"
            android:textSize="20sp"
            android:textStyle="bold" />


        <RadioButton
        android:id="@+id/postevent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/POST_EVENT"
        android:textSize="20sp"
        android:textStyle="bold" />

        <RadioButton
            android:id="@+id/deleteResident"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/DELETE_RESIDENT"
            android:textSize="20sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/deleteVacantFlat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/DELETE_VACANTFLAT"
            android:textSize="20sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/viewfeedbacks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/VIEW_FEEDBACKS"
            android:textSize="20sp"
            android:textStyle="bold" />
        <RadioButton
            android:id="@+id/viewcomplaints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/VIEW_COMPLAINTS"
            android:textSize="20sp"
            android:textStyle="bold" />
        <RadioButton
            android:id="@+id/postreminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/POST_REMAINDER"
            android:textSize="20sp"
            android:textStyle="bold" />
        <RadioButton
            android:id="@+id/addelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/ADD_ELECTION"
            android:textSize="20sp"
            android:textStyle="bold" />
        <RadioButton
            android:id="@+id/viewelections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/VIEW_ELECTIONS"
            android:textSize="20sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/discussionforums"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/DISCUSSION_FORUMS"
            android:textSize="20sp"
            android:textStyle="bold" />


    </RadioGroup>

    <Button
        style="@style/ButtonStyle"
        android:layout_marginTop="10dp"
        android:onClick="next"
        android:text="@string/NEXT"
        />

</LinearLayout>
</ScrollView>