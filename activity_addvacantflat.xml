<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    >

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/background">



    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/ADD_VACANT_FLAT"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/flat_number"
        style="@style/EditTextStyle"
        android:layout_width="331dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="@string/ENTER_FLAT_NUMBER"
        android:inputType="text" />

    <LinearLayout style="@style/LinearLayoutStyle" />

    <EditText
        android:id="@+id/floor_number"
        style="@style/EditTextStyle"
        android:layout_width="331dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif"
        android:hint="@string/ENTER_FLOOR_NUMBER"
        android:inputType="text" />

    <LinearLayout style="@style/LinearLayoutStyle" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="left"
        android:text="@string/FURNISHED"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/furnished"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <RadioButton
            style="@style/RadioButtonStyle"
            android:id="@+id/fully_furnished"
            android:text="@string/FULLY_FURNISHED"
            android:checked="true"
            />
        <RadioButton
            style="@style/RadioButtonStyle"

            android:id="@+id/semi_furnished"
            android:text="@string/SEMI_FURNISHED"
            />
        <RadioButton
            style="@style/RadioButtonStyle"

            android:id="@+id/not_furnished"
            android:text="@string/NOT_FURNISHED"

            />

    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="left"
        android:text="@string/NUMBER_OF_BEDROOMS"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/number_of_bedrooms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <RadioButton
            style="@style/RadioButtonStyle"

            android:id="@+id/one"
            android:text="@string/ONE"
            android:checked="true"

            />
        <RadioButton
            style="@style/RadioButtonStyle"
            android:id="@+id/two"
            android:text="@string/TWO"
            />
        <RadioButton
            style="@style/RadioButtonStyle"

            android:id="@+id/three"
            android:text="@string/THREE"
            />
        <RadioButton
            style="@style/RadioButtonStyle"

            android:id="@+id/four"
            android:text="@string/FOUR"
            />
    </RadioGroup>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="left"
        android:text="@string/FLAT_TYPE"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/occupancy_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <RadioButton
            style="@style/RadioButtonStyle"

            android:id="@+id/rent"
            android:text="@string/RENT"
            android:checked="true"

            />
        <RadioButton
            style="@style/RadioButtonStyle"
            android:id="@+id/sale"
            android:text="@string/SALE"
            />
    </RadioGroup>

    <Button
        style="@style/ButtonStyle"
        android:layout_marginTop="10dp"
        android:onClick="addVacantFlat"
        android:text="@string/ADD" />


</LinearLayout>
</ScrollView>

