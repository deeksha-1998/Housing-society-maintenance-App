<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    >

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/background">



    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/ADD_RESIDENT"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/name"
        style="@style/EditTextStyle"
        android:layout_width="331dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="@string/ENTER_RESIDENT_NAME"
        android:inputType="text" />

    <LinearLayout style="@style/LinearLayoutStyle" />
    <EditText
        android:id="@+id/username"
        style="@style/EditTextStyle"
        android:layout_width="331dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif"
        android:hint="@string/ENTER_USERNAME"
        android:inputType="text" />

    <LinearLayout style="@style/LinearLayoutStyle" />


    <EditText
        android:id="@+id/password"
        style="@style/EditTextStyle"
        android:layout_width="337dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif"
        android:inputType="textPassword"
        android:hint="@string/ENTER_PASSWORD"
        />

    <LinearLayout style="@style/LinearLayoutStyle" />

    <EditText
        android:layout_marginTop="20dp"
        style="@style/EditTextStyle"
        android:hint="@string/CONFIRM_PASSWORD"
        android:id="@+id/confirmpassword"
        android:inputType="textPassword"/>
    <LinearLayout style="@style/LinearLayoutStyle" />

    <EditText
        android:id="@+id/contact"
        style="@style/EditTextStyle"
        android:layout_width="331dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif"
        android:hint="@string/ENTER_CONTACT"
        android:inputType="phone" />

    <LinearLayout style="@style/LinearLayoutStyle" />


    <EditText
        android:id="@+id/mail"
        style="@style/EditTextStyle"
        android:layout_width="337dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif"
        android:hint="@string/ENTER_MAIL"
        android:inputType="textEmailAddress"
        />

    <LinearLayout style="@style/LinearLayoutStyle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="left"
        android:text="@string/SELECT_FLAT"
        android:textColor="@color/primary_text"
        android:textSize="18sp"
        android:textStyle="bold" />


    <Spinner
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/primary_text"
        android:id="@+id/flat"
        android:layout_marginTop="10dp"
        />


    <LinearLayout style="@style/LinearLayoutStyle" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="left"
        android:text="@string/FLAT_TYPE"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/flat_occupancy_type"
        >

        <RadioButton
            style="@style/RadioButtonStyle"
            android:text="@string/RENT"
            android:id="@+id/rent"
            android:checked="true"
            />

        <RadioButton
            style="@style/RadioButtonStyle"
            android:text="@string/OWN"
            android:id="@+id/own"
            />
    </RadioGroup>
    <LinearLayout style="@style/LinearLayoutStyle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/PROFILE_PIC"
        android:layout_margin="10dp"
        android:textSize="18sp"
        android:textColor="@color/primary_text"
        android:onClick="selectPhoto"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        />
    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:visibility="gone"
        android:id="@+id/image"
        android:layout_gravity="center"
        android:layout_margin="20dp"/>

    <Button
        style="@style/ButtonStyle"
        android:layout_marginTop="10dp"
        android:onClick="addResident"
        android:text="@string/ADD" />


</LinearLayout>
</ScrollView>

