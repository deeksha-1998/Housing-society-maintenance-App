<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    >
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="wrap_content"
        android:layout_height="150dp"
        android:src="@drawable/admin"
        android:layout_gravity="center"
         />

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/options"
        android:layout_margin="10dp"
        android:layout_marginTop="20dp">

        <RadioButton
            android:id="@+id/addapartment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/ADD_APARTMENT"
            android:textSize="20sp"
            android:checked="true"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/addmaintenanceofficer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/ADD_MAINTENANCE_OFFICER"
            android:textSize="20sp"
            android:textStyle="bold" />


        <RadioButton
        android:id="@+id/postupcomingapartment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/POST_UPCOMING_APARTMENT"
        android:textSize="20sp"
        android:textStyle="bold" />

        <RadioButton
            android:id="@+id/addflat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/ADD_FLAT"
            android:textSize="20sp"
            android:textStyle="bold" />
        <RadioButton
            android:id="@+id/discussionforums"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/DISCUSSION_FORUMS"
            android:textSize="20sp"
            android:textStyle="bold" />

    </RadioGroup>

    <Button
        android:id="@+id/btn_nextadmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/button_selector"
        style="@style/ButtonStyle"
        android:layout_margin="10dp"
        android:onClick="next"
        android:text="@string/NEXT"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        />

</LinearLayout>
</ScrollView>